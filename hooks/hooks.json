{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/prompt-submit.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/capture.mjs\""
          }
        ]
      }
    ]
  }
}
